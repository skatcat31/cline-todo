# The latest eslint-plugin-react (7.37.x) declares "eslint <= ^9.7" as its
# peer range, even though it works fine with ESLint 10. Ignore stale peer
# ranges so installs keep working until its peer range catches up.
# Temporary workaround until eslint-plugin-react declares support for
# ESLint 10 (its peer range is stale at "eslint <= ^9.7"). Dependabot has
# already bumped the plugins, so remove this flag once the plugin follows.
legacy-peer-deps=true
